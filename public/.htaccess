# ========================================================
# Top Linkers Real Estate, Construction & Solar - .htaccess
# ========================================================

# 1. Custom 404 Error Document (Returns genuine HTTP 404 status code)
ErrorDocument 404 /404.html

DirectoryIndex index.html index.php
Options -Indexes
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to .well-known for RFC 8615 and SEP-1649 MCP discovery
  RewriteRule ^\.well-known/ - [L]

  # Direct access to AdSense verification and crawler files (Serves HTTP 200 directly with zero redirects)
  RewriteRule ^(ads\.txt|app-ads\.txt|robots\.txt|sitemap\.xml)$ - [L]

  # ----------------------------------------------------
  # CANONICAL REDIRECTS (Resolves GSC "Alternate Page" Status)
  # ----------------------------------------------------

  # A. Force HTTPS (HTTP -> HTTPS 301 Redirect)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =http
  RewriteRule ^ https://toplinkersgroup.com%{REQUEST_URI} [R=301,L,NE]

  # B. Force non-WWW (www -> non-www 301 Redirect)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # C. Strip .html extension (e.g. /about.html -> /about 301 Redirect)
  # Prevents search engines from indexing both .html and extensionless URLs
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^ /%1 [R=301,L,NE]

  # D. Normalize Trailing Slashes (Strip trailing slash: /services/ -> /services 301 Redirect)
  # Prevents search engines from indexing both trailing and non-trailing slash URLs
  # Excludes root /, /api/, and /admin/
  RewriteCond %{THE_REQUEST} \s/+(.+?)/+[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/admin/
  RewriteRule ^ /%1 [R=301,L,NE]

  # E. Common Legacy URL Aliases 301 Redirects
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^properties/?$ /listings [R=301,L]
  RewriteRule ^property/?$ /listings [R=301,L]
  RewriteRule ^terms/?$ /terms-and-conditions [R=301,L]
  RewriteRule ^terms-conditions/?$ /terms-and-conditions [R=301,L]
  RewriteRule ^privacy/?$ /privacy-policy [R=301,L]
  RewriteRule ^disclaimer-policy/?$ /disclaimer [R=301,L]
  RewriteRule ^harsukh/?$ /hr-sukh [R=301,L]
  RewriteRule ^harsukh-residencies/?$ /hr-sukh [R=301,L]
  RewriteRule ^property/topcity1-10-marla-prime-plot/?$ /property/corner-plot-topcity [R=301,L]

  # Serve Markdown representation when agents request Accept: text/markdown
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteRule ^(index\.html)?$ /index.md [L]

  # ----------------------------------------------------
  # Legacy Property URL 301 Redirects (Mapped to live canonical targets)
  # ----------------------------------------------------
  RewriteRule ^property/luxury-corner-penthouse-bano-qadeer-heights-11/?$ /listings [R=301,L]
  RewriteRule ^property/executive-family-house-gulberg-greens-residencia-12/?$ /listings [R=301,L]
  RewriteRule ^property/commercial-retail-plaza-storefront-faisal-town-phase-ii-ft-ii-13/?$ /property/faisal-town-phase-2-installment-plot [R=301,L]
  RewriteRule ^property/contemporary-farmhouse-estate-topcity-1-top-residencia-14/?$ /property/corner-plot-topcity [R=301,L]
  RewriteRule ^property/lake-view-duplex-apartment-pha-flats-sector-i-12-15/?$ /property/pha-flats-i12-1-type-d-e-2bed [R=301,L]
  RewriteRule ^property/spanish-architecture-villa-pha-flats-sector-i-16-16/?$ /property/pha-flats-i16-3-type-b-3bed [R=301,L]
  RewriteRule ^property/prime-commercial-office-suite-pechs-society-17/?$ /property/pechs-islamabad-5-marla-plot [R=301,L]
  RewriteRule ^property/scenic-hillside-residence-dha-phase-2-5-18/?$ /listings [R=301,L]
  RewriteRule ^property/turnkey-furnished-townhouse-bahria-town-phase-7-8-19/?$ /listings [R=301,L]
  RewriteRule ^property/modern-designer-villa-blue-world-city-20/?$ /listings [R=301,L]
  RewriteRule ^property/luxury-corner-penthouse-b-17-multi-gardens-21/?$ /listings [R=301,L]
  RewriteRule ^property/executive-family-house-h-r-luxury-suites-gulberg-22/?$ /property/hr-sukh-luxury-flats-nathia-gali [R=301,L]
  RewriteRule ^property/commercial-retail-plaza-storefront-bano-qadeer-heights-23/?$ /listings [R=301,L]
  RewriteRule ^property/contemporary-farmhouse-estate-gulberg-greens-residencia-24/?$ /listings [R=301,L]
  RewriteRule ^property/lake-view-duplex-apartment-faisal-town-phase-ii-ft-ii-25/?$ /property/faisal-town-phase-2-installment-plot [R=301,L]
  RewriteRule ^property/spanish-architecture-villa-topcity-1-top-residencia-26/?$ /property/corner-plot-topcity [R=301,L]
  RewriteRule ^property/prime-commercial-office-suite-pha-flats-sector-i-12-27/?$ /property/pha-flats-i12-1-type-d-e-2bed [R=301,L]
  RewriteRule ^property/scenic-hillside-residence-pha-flats-sector-i-16-28/?$ /property/pha-flats-i16-3-type-b-3bed [R=301,L]
  RewriteRule ^property/turnkey-furnished-townhouse-pechs-society-29/?$ /property/pechs-islamabad-5-marla-plot [R=301,L]
  RewriteRule ^property/modern-designer-villa-dha-phase-2-5-30/?$ /listings [R=301,L]
  RewriteRule ^property/luxury-corner-penthouse-bahria-town-phase-7-8-31/?$ /listings [R=301,L]
  RewriteRule ^property/executive-family-house-blue-world-city-32/?$ /listings [R=301,L]
  RewriteRule ^property/commercial-retail-plaza-storefront-b-17-multi-gardens-33/?$ /listings [R=301,L]
  RewriteRule ^property/contemporary-farmhouse-estate-h-r-luxury-suites-gulberg-34/?$ /property/hr-sukh-luxury-flats-nathia-gali [R=301,L]
  RewriteRule ^property/lake-view-duplex-apartment-bano-qadeer-heights-35/?$ /listings [R=301,L]
  RewriteRule ^property/spanish-architecture-villa-gulberg-greens-residencia-36/?$ /listings [R=301,L]
  RewriteRule ^property/prime-commercial-office-suite-faisal-town-phase-ii-ft-ii-37/?$ /property/faisal-town-phase-2-installment-plot [R=301,L]
  RewriteRule ^property/scenic-hillside-residence-topcity-1-top-residencia-38/?$ /property/corner-plot-topcity [R=301,L]
  RewriteRule ^property/turnkey-furnished-townhouse-pha-flats-sector-i-12-39/?$ /property/pha-flats-i12-1-type-d-e-2bed [R=301,L]
  RewriteRule ^property/modern-designer-villa-pha-flats-sector-i-16-40/?$ /property/pha-flats-i16-3-type-b-3bed [R=301,L]

  # ----------------------------------------------------
  # 3. Server-Side Protection and Routing for /admin Executive Suite
  # ----------------------------------------------------
  # Direct visits to /admin/login serve the clean executive admin SPA shell
  RewriteCond %{REQUEST_URI} ^/admin/login/?$ [NC]
  RewriteRule ^ /admin-shell.html [L]

  # Unauthenticated visits to protected admin pages are redirected to /admin/login
  RewriteCond %{REQUEST_URI} ^/admin(/.*)?$ [NC]
  RewriteCond %{HTTP_COOKIE} !tl_admin_session= [NC]
  RewriteRule ^ /admin/login [R=302,L]

  # Authenticated visits to ANY /admin or /admin/* route serve the clean executive admin SPA shell
  RewriteCond %{REQUEST_URI} ^/admin(/.*)?$ [NC]
  RewriteRule ^ /admin-shell.html [L]

  # ----------------------------------------------------
  # 3B. Dynamic Server API Routing (Central SQLite Database Engine)
  # ----------------------------------------------------
  # Pass admin_auth.php directly
  RewriteCond %{REQUEST_URI} ^/api/admin_auth\.php [NC]
  RewriteRule ^ - [L]

  # Route all /api/* requests to /api/index.php
  RewriteCond %{REQUEST_URI} ^/api/(.*)$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ /api/index.php [QSA,L]

  # ----------------------------------------------------
  # 4. Physical Files & Pre-rendered Static Pages Serving
  # ----------------------------------------------------
  # If requested path is an existing physical file, serve directly
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If requested path has a pre-rendered .html file, serve it immediately with HTTP 200 OK
  RewriteCond %{REQUEST_FILENAME}.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
  RewriteRule ^(.*)$ /$1.html [L,QSA]

  # If requested path has a subfolder index.html, serve that index.html with HTTP 200 OK
  RewriteCond %{REQUEST_FILENAME}/index.html -f [OR]
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L,QSA]

  # If requested path is an existing directory with an index.html, serve directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # ----------------------------------------------------
  # 5. Genuine 404 Response for Unknown URLs
  # ----------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# Modern MIME Types
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType text/plain .txt
  AddType text/markdown .md
  AddType application/json .json
</IfModule>

# Content-Type & Agent Headers for Specific Endpoints
<Files "ads.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
  Header set Cache-Control "public, max-age=3600"
  Header unset X-Frame-Options
</Files>

<Files "app-ads.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
  Header set Cache-Control "public, max-age=3600"
  Header unset X-Frame-Options
</Files>

<Files "llms.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</Files>

<Files "llms-full.txt">
  ForceType text/plain
  Header set Content-Type "text/plain; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</Files>

<Files "index.md">
  ForceType text/markdown
  Header set Content-Type "text/markdown; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
  Header set Vary "Accept"
</Files>

<Files "server-card.json">
  ForceType application/json
  Header set Content-Type "application/json; charset=utf-8"
  Header set Access-Control-Allow-Origin "*"
</Files>

# RFC 8288 Link Headers for Homepage Agent Resource Discovery
<FilesMatch "^(index\.html)?$">
  <IfModule mod_headers.c>
    Header add Link '<https://toplinkersgroup.com/llms.txt>; rel="alternate"; type="text/plain"'
    Header add Link '<https://toplinkersgroup.com/index.md>; rel="alternate"; type="text/markdown"'
    Header add Link '<https://toplinkersgroup.com/.well-known/mcp/server-card.json>; rel="service-desc"; type="application/json"'
    Header set Vary "Accept"
  </IfModule>
</FilesMatch>

# Browser Caching
<IfModule mod_headers.c>
  # API and Dynamic PHP endpoints must NEVER be cached
  <FilesMatch "\.(php|json|sqlite)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Content-hashed assets immutable
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images & icons
  <FilesMatch "\.(avif|webp|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
  </FilesMatch>
  # HTML always revalidates for instant deployment updates
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# Brotli & Gzip Compression
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml text/markdown application/ld+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml text/markdown application/ld+json
  <IfModule mod_filter.c>
    FilterDeclare Compression CONTENT_SET
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'text/html'"
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'text/css'"
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'application/javascript'"
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'application/json'"
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'image/svg+xml'"
    FilterProvider Compression DEFLATE "%{CONTENT_TYPE} = 'application/ld+json'"
    FilterChain Compression
  </IfModule>
</IfModule>

# Security & Header Protections
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Direct Googlebot and search crawlers to exclude client-state utility pages
  <If "%{REQUEST_URI} =~ m#^/(favorites|create-listing|search)(/.*)?$#">
    Header set X-Robots-Tag "noindex, follow"
  </If>
</IfModule>
